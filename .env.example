# Copy this file to .env.<owner-initials> (e.g. .env.al for Alice) and fill
# in the values. Each developer who runs an agent slot on the host gets their
# own .env.<initials> file; the per-host docker-compose.yml points each
# agent service at the matching env file via `env_file:`.
# All .env.* files are gitignored — never committed.

# --- Tailscale auth ---
# Single-use (or reusable) auth key from your Tailscale admin console:
#   https://login.tailscale.com/admin/settings/keys
# The container joins the tailnet as `agent-${AGENT_ID}` (e.g. agent-al-01),
# becoming reachable to other tailnet members only. sshd inside the container
# handles shell auth (key or password) — see SSH section below.
# Recommended: ephemeral + tagged auth key (e.g. tag:agent) so ACLs scope what
# each agent can reach.
TS_AUTHKEY=

# --- Tailscale hostname (optional override) ---
# Defaults to "agent-${AGENT_ID}" if unset. Useful when the same AGENT_ID
# might collide across hosts and you want explicit naming.
#TS_HOSTNAME=

# --- GitHub auth ---
# Fine-grained PAT for a dedicated machine user (one per organization is
# typical). Required scopes: Contents (read/write) + Pull requests (read/write)
# on whatever repos agents will touch.
# Generate at: https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=

# --- Anthropic auth ---
# API key for the Claude Code CLI inside the container.
# Generate at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Git author identity ---
# Used for commits/PRs made by agents. Match the bot account, not your own.
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=

# --- SSH access ---
# The container's sshd is reachable ONLY via your tailnet (no public ports
# mapped). Tailscale identity gates network reach; SSH (key or password)
# gates shell access. This two-layer model is safer than public-internet
# SSH, so password auth here is fine.
#
# Public key(s) allowed to log in as `agent`. Single line per key, or use
# literal \n to separate multiple keys:
#   SSH_AUTHORIZED_KEYS=ssh-ed25519 AAAA... my-laptop
#   SSH_AUTHORIZED_KEYS=ssh-ed25519 AAAA... key1\nssh-ed25519 BBBB... key2
SSH_AUTHORIZED_KEYS=

# Optional: password for the `agent` user. Useful for Claude Code Desktop's
# SSH connector, which currently doesn't read IdentityFile cleanly (issue
# anthropics/claude-code#25661). Safe on tailnet-only sshd; would NOT be safe
# on a public-internet sshd.
SSH_PASSWORD=

# --- Optional: repos to auto-clone on first agent boot ---
# Space-separated `owner/repo` shorthand or full git URLs. Each is cloned into
# /workspace/<repo-name>/ on container start. Idempotent (skips existing).
# Uses GITHUB_TOKEN above for HTTPS auth.
# Leave empty for a one-off / scratch agent with no fixed repo set.
AGENT_REPOS=

# --- Optional: enable in-container Docker daemon for Testcontainers etc. ---
# Requires the outer container runtime to provide nested-container isolation
# (sysbox-runc on Linux — set up by infra/bootstrap.sh).
AGENT_ENABLE_DOCKER=
