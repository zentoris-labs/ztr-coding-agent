# Copy this file to `.env` on the host and fill in the values. ONE `.env`
# per VM — Docker Compose auto-loads it for BOTH variable interpolation in
# `docker-compose.yml` (e.g. ${INITIALS}) AND as the env_file passed into
# every agent container. `.env` is gitignored.

# --- Owner initials ---
# Drives every container's hostname/tailnet identity: agent-${INITIALS}-NN.
# Use the same initials as your Tailscale tag (`tag:agent-${INITIALS}`).
# Examples: ch (Christof), al (Alice), bob (Bob).
INITIALS=

# --- How many agents to run ---
# `docker-compose.yml` defines 20 slots (agent-01 ... agent-20) with
# cumulative profiles. Set this to the count you want and you get
# agent-01 through agent-<N>. Without this set, NOTHING starts.
# Examples:
#   COMPOSE_PROFILES=1     # just agent-01
#   COMPOSE_PROFILES=3     # agent-01, agent-02, agent-03
#   COMPOSE_PROFILES=all   # every slot
COMPOSE_PROFILES=1

# --- Tailscale auth ---
# Reusable auth key (REUSABLE because we're running 2-5 agents off one
# `.env`; single-use keys would burn on the first agent's registration).
# Generate at: https://login.tailscale.com/admin/settings/keys
# Tag it `tag:agent-${INITIALS}` and toggle "Reusable" on.
TS_AUTHKEY=

# --- GitHub auth ---
# Fine-grained PAT for a dedicated machine user (one per organization is
# typical). Required scopes: Contents (read/write) + Pull requests (read/write)
# on whatever repos agents will touch.
# Generate at: https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=

# --- Git author identity ---
# Used for commits/PRs made by agents. Match the bot account, not your own.
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=

# --- SSH access ---
# REQUIRED. The container's sshd is reachable ONLY via your tailnet — no
# public ports mapped. Tailscale identity gates network reach; this password
# gates shell access as the `agent` user. Two-layer model: safe.
#
# Key auth was removed because Claude Code Desktop's SSH connector can't
# use IdentityFile cleanly (anthropics/claude-code#25661); password auth is
# the supported path.
SSH_PASSWORD=

# --- Optional: repos to auto-clone on first agent boot ---
# Space-separated `owner/repo` shorthand or full git URLs. Each is cloned into
# /home/agent/<repo-name>/ on container start. Idempotent (skips existing).
# Uses GITHUB_TOKEN above for HTTPS auth.
# Leave empty for a one-off / scratch agent with no fixed repo set.
AGENT_REPOS=

# --- In-container Docker daemon (Testcontainers, nested builds, etc.) ---
# Enabled by default. Per-host isolation model: the agent container runs
# `privileged: true` in compose, so the in-container dockerd starts as plain
# rootful Docker — no host-side runtime config required. `/var/lib/docker` is
# a named volume per agent so overlay2 doesn't trip on the container's own
# overlay rootfs (Testcontainers needs this — see docker-compose.yml).
# Set to 0 to skip starting dockerd (faster boot if you don't need it).
#AGENT_ENABLE_DOCKER=1
