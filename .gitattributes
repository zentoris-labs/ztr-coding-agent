# Default to LF, override binaries below.
* text=auto eol=lf

# Files that MUST stay LF even on Windows clones — bash scripts and Dockerfile
# break with CRLF when executed inside the Linux container.
*.sh        text eol=lf
*.bash      text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
.env*       text eol=lf

# Binaries — never normalize
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
